digraph Username {

      graph [bgcolor="white", pad="0.25", nodesep="0.28", ranksep="0.55", fontname="DejaVu Sans", labeljust="l"];
      node [shape=circle, style="filled", fillcolor="#EEF3FB", color="#3157A4", penwidth=1.35,
            fontname="DejaVu Sans", fontsize=10, width=0.58, height=0.58, fixedsize=true];
      edge [color="#41536F", penwidth=1.2, arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];
    
rankdir=LR;
start [shape=point, width=0.12, label=""];
start -> q0;
q0 [shape=circle, label="q0"];
q1 [shape=circle, label="q1"];
q2 [shape=circle, label="q2"];
q3 [shape=circle, label="q3"];
q4 [shape=circle, label="q4"];
q5 [shape=doublecircle, label="q5"];
q6 [shape=doublecircle, label="q6"];
q7 [shape=doublecircle, label="q7"];
q8 [shape=doublecircle, label="q8"];
q9 [shape=doublecircle, label="q9"];
q10 [shape=doublecircle, label="q10"];
q11 [shape=doublecircle, label="q11"];
q12 [shape=doublecircle, label="q12"];
q13 [shape=doublecircle, label="q13"];
q14 [shape=doublecircle, label="q14"];
q15 [shape=doublecircle, label="q15"];
qX [label="qX", fillcolor="#FDEBE8", color="#B94738"];
q0 -> q1 [label="L"];
q1 -> q2 [label="L / D / _"];
q2 -> q3 [label="L / D / _"];
q3 -> q4 [label="L / D / _"];
q4 -> q5 [label="L / D / _"];
q5 -> q6 [label="L / D / _"];
q6 -> q7 [label="L / D / _"];
q7 -> q8 [label="L / D / _"];
q8 -> q9 [label="L / D / _"];
q9 -> q10 [label="L / D / _"];
q10 -> q11 [label="L / D / _"];
q11 -> q12 [label="L / D / _"];
q12 -> q13 [label="L / D / _"];
q13 -> q14 [label="L / D / _"];
q14 -> q15 [label="L / D / _"];
q15 -> qX [label="extra char", color="#B94738"];
label="Accepting lengths: q5 through q15; L=letter, D=digit, _=underscore"; labelloc=b; fontsize=9; fontcolor="#64748B";
}